# Production Google OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Local Firebase Emulator Suite (Android emulator defaults to 10.0.2.2)
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2
EXPO_PUBLIC_EMULATOR_EMAIL=seeker1@iiitkottayam.ac.in
EXPO_PUBLIC_EMULATOR_PASSWORD=openverse-dev

# App Check debug token for development/emulator builds only (register it in
# Firebase Console > App Check > Manage debug tokens). Release builds ignore it
# and always use Play Integrity. Never commit a real token.
# EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=
