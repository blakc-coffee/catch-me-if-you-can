# =============================================================================
# OpenVerse Native — environment profiles
# Copy to .env.local (never commit secrets).
# =============================================================================

# --- Production (https://solvenseek.vercel.app + Convex backend) ---
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=762238097989-xxxxxxxx.apps.googleusercontent.com

# Firebase Auth is still used for Google Sign-In; Convex validates Firebase JWTs.

# App Check: register debug token in Firebase Console > App Check for dev builds
# EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=your-debug-token

# Demo accounts (optional; create in Firebase Auth console for staging)
# EXPO_PUBLIC_DEMO_EMAIL=demoseeker@openverse.net
# EXPO_PUBLIC_DEMO_PASSWORD=demoseeker123
# EXPO_PUBLIC_DEMO_EMAIL_BRAVO=demoseeker2@openverse.net
# EXPO_PUBLIC_DEMO_PASSWORD_BRAVO=demoseeker123

# --- Local dev (Firebase Emulator Suite + solvenseek on localhost) ---
# EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2
# EXPO_PUBLIC_EMULATOR_EMAIL=seeker1@iiitkottayam.ac.in
# EXPO_PUBLIC_EMULATOR_PASSWORD=openverse-dev

# USB-connected physical device: use adb reverse and point host at localhost
#   adb reverse tcp:8080 tcp:8080
#   adb reverse tcp:9099 tcp:9099
#   adb reverse tcp:5001 tcp:5001
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# --- EAS preview APK (production Firebase, no emulators) ---
# Set in eas.json preview profile or EAS secrets:
# EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
