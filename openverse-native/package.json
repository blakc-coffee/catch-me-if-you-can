{
  "name": "openverse-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "prebuild": "expo prebuild",
    "build:apk": "npx eas-cli build --platform android --profile preview",
    "update:preview": "npx eas-cli update --channel preview --environment preview",
    "update:prod": "npx eas-cli update --channel production --environment production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/app-check": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/functions": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~57.0.0",
    "expo-camera": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-location": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-task-manager": "~57.0.0",
    "expo-updates": "~57.0.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
