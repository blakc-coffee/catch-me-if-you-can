# Copy to .env.<projectId> (git-ignored) to configure a deployed project.
# Non-secret configuration only; this backend needs no runtime secrets.

# App Check (see README "App Check"). The Functions emulator never enforces.
#   unset  → sensitive callables (updateTelemetry, uploadLocationBatch,
#            claimArtifact, submitPuzzleAnswer, joinTeam) require App Check
#   true   → every callable requires App Check
#   false  → nothing requires App Check (temporary rollout escape hatch only)
# ENFORCE_APP_CHECK=true
