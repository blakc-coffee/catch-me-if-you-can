rules_version = '2';

// OpenVerse Firestore security rules: direct Firestore mode.
// Allows mobile seekers to write their own location and read game state directly,
// and allows the surveillance portal to read real-time seeker telemetry.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // User profile: self can read & write
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    // Teams: any signed-in user can read; signed-in users can update counters/join
    match /teams/{teamId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Artifacts & areas
    match /artifacts/{qrCode} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /areas/{areaId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Game lifecycle and state
    match /game/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Live seeker telemetry:
    // Real-time surveillance portal can read; seeker can write their own location
    match /seekers/{uid} {
      allow read: if true;
      allow write: if isSelf(uid);

      match /locationBatches/{batchId} {
        allow read, write: if isSelf(uid);
      }
    }

    // Artifact claims & puzzle unlocks
    match /artifactClaims/{claimId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /puzzleUnlocks/{unlockId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /puzzlePublic/{puzzleId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /puzzleClaims/{puzzleId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /puzzles/{puzzleId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
